WEB_PORT=3000
API_PYTHON_PORT=8000

PUID=1000
PGID=1000

SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars
MONITOR_ROOT=/monitor
EBOOK_CONVERSION_ENABLED=true
LIBMOBI_BIN=mobitool
EBOOK_CONVERSION_TIMEOUT_SECONDS=600
MONITOR_HOST_PATH=./monitor
STORAGE_PATH=./data/storage
PUBLIC_APP_URL=https://books.example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=books@example.com
SMTP_STARTTLS=true
SMTP_USE_SSL=false
KINDLE_SEND_QUEUE_ENABLED=true
KINDLE_SEND_QUEUE_INTERVAL_SECONDS=5
