if (is_android) {
  shared_library("shuku_pdfium") {
    configs -= [ "//build/config/android:hide_all_but_jni_onload" ]
    inputs = [ "shuku_pdfium.exports" ]
    ldflags = [
      "-Wl,--version-script=" +
          rebase_path("shuku_pdfium.exports", root_build_dir),
    ]
    sources = [
      "src/shuku_pdfium.cc",
      "src/shuku_pdfium_android_jni.cc",
      "src/shuku_pdfium_revision.cc",
    ]
    include_dirs = [ "include", "//" ]
    deps = [ "//:pdfium" ]
  }
} else if (is_ios) {
  static_library("shuku_pdfium") {
    complete_static_lib = true
    sources = [
      "src/shuku_pdfium.cc",
      "src/shuku_pdfium_revision.cc",
    ]
    include_dirs = [ "include", "//" ]
    deps = [ "//:pdfium" ]
  }
}
