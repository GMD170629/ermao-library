{
  "name": "@shuku/web",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/prepare-pdfjs-worker.mjs",
    "dev": "next dev -p 3000",
    "predev:ios": "node scripts/prepare-pdfjs-worker.mjs",
    "dev:ios": "next dev -H 0.0.0.0 -p 3000",
    "prebuild": "node scripts/prepare-pdfjs-worker.mjs",
    "build": "next build",
    "start": "next start -p 3000",
    "start:ios": "next start -H 0.0.0.0 -p 3000",
    "pwa:ios": "pnpm build && pnpm start:ios",
    "generate:reader-api": "cd ../api-python && uv run python scripts/export_openapi.py ../web/.reader-openapi.json && cd ../web && node scripts/generate-reader-api.mjs .reader-openapi.json generated/reader-v2.ts",
    "lint": "next lint",
    "test": "tsx --test 'lib/**/*.test.ts' 'features/**/*.test.ts'",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@shuku/reader-core": "workspace:*",
    "epubjs": "0.3.93",
    "framer-motion": "^11.3.24",
    "lucide-react": "^0.451.0",
    "next": "14.2.15",
    "pdfjs-dist": "6.1.200",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "^22.7.6",
    "@types/react": "^18.3.9",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.15",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
