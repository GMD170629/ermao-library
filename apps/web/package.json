{
  "name": "@shuku/web",
  "version": "0.5.5",
  "private": true,
  "scripts": {
    "predev": "node scripts/prepare-pdfjs-worker.mjs",
    "dev": "next dev --webpack -H 0.0.0.0 -p 3000",
    "predev:ios": "node scripts/prepare-pdfjs-worker.mjs",
    "dev:ios": "next dev --webpack -H 0.0.0.0 -p 3000",
    "prebuild": "node scripts/prepare-pdfjs-worker.mjs",
    "build": "next build",
    "start": "next start -p 3000",
    "start:ios": "next start -H 0.0.0.0 -p 3000",
    "pwa:ios": "pnpm build && pnpm start:ios",
    "generate:reader-api": "cd ../api-python && uv run python scripts/export_openapi.py ../web/.reader-openapi.json && cd ../web && node scripts/generate-reader-api.mjs .reader-openapi.json generated/reader-v4.ts",
    "lint": "eslint . --max-warnings=0",
    "pretest": "node scripts/generate-i18n-catalog.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "i18n:extract": "node scripts/generate-i18n-catalog.mjs --write",
    "i18n:check": "node scripts/generate-i18n-catalog.mjs",
    "i18n:overrides": "node scripts/apply-i18n-overrides.mjs",
    "i18n:migrate-jsx": "node scripts/migrate-i18n-jsx-text.mjs",
    "i18n:migrate-attributes": "node scripts/migrate-i18n-jsx-attributes.mjs",
    "i18n:migrate-expressions": "node scripts/migrate-i18n-jsx-expressions.mjs"
  },
  "dependencies": {
    "@readium/navigator": "2.8.2",
    "@readium/shared": "2.4.0",
    "@shuku/reader-core": "workspace:*",
    "lucide-react": "^0.451.0",
    "next": "16.2.12",
    "pdfjs-dist": "6.1.200",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "^22.7.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "^10.4.20",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
