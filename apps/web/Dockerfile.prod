FROM node:22.23.1-bookworm-slim AS deps
WORKDIR /app
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY apps/web/package.json apps/web/package.json
COPY packages/reader-core/package.json packages/reader-core/package.json
COPY patches ./patches
RUN pnpm install --frozen-lockfile --filter @shuku/web...

FROM deps AS builder
ARG SHUKU_BASE_PATH=
ENV NEXT_PUBLIC_BASE_PATH=$SHUKU_BASE_PATH
COPY . .
RUN pnpm --filter @shuku/web build

FROM debian:bookworm-slim AS mobi-core-builder
RUN apt-get update \
  && apt-get install -y --no-install-recommends build-essential cmake zlib1g-dev \
  && rm -rf /var/lib/apt/lists/*
COPY apps/mobile/native/mobi-core /src/mobi-core
RUN cmake -S /src/mobi-core -B /build/mobi-core \
      -DERMAO_MOBI_BUILD_TESTS=OFF \
      -DERMAO_MOBI_BUILD_FUZZER=OFF \
  && cmake --build /build/mobi-core --config Release --target ermao_mobi_core_shared
COPY packages/reader-core/native/chapters /src/chapters
RUN cmake -S /src/chapters -B /build/chapters -DBUILD_TESTING=OFF \
  && cmake --build /build/chapters --config Release --target ermao_chapters_shared

FROM python:3.11.15-slim-bookworm AS runner
WORKDIR /opt/shuku-image
ENV SHUKU_CONTAINER=1 \
  STORAGE_ROOT=/app/storage \
    NODE_ENV=production \
  NEXT_TELEMETRY_DISABLED=1 \
  HOSTNAME=0.0.0.0 \
  PORT=3000 \
  PYTHONDONTWRITEBYTECODE=1 \
  PYTHONUNBUFFERED=1 \
  ERMAO_MOBI_CORE_LIBRARY=/usr/local/lib/libermao_mobi_core.so \
  ERMAO_CHAPTER_CORE_LIBRARY=/usr/local/lib/libermao_chapters.so \
  PATH=/opt/shuku-python/bin:$PATH

COPY --from=deps /usr/local/bin/node /usr/local/bin/node
COPY --from=ghcr.io/astral-sh/uv:0.11.29 /uv /usr/local/bin/uv

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates libstdc++6 unar ffmpeg \
  && rm -rf /var/lib/apt/lists/* \
  && node --version \
  && python --version \
  && ffprobe -version

COPY --from=builder /app/scripts/start-unified-app.sh ./scripts/start-unified-app.sh
COPY --from=builder /app/scripts/unified-http-gateway.mjs ./scripts/unified-http-gateway.mjs
COPY --from=builder /app/apps/web/.next/standalone ./
COPY --from=builder /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder /app/apps/web/public ./apps/web/public
COPY --from=builder /app/apps/api-python/app ./apps/api-python/app
COPY --from=builder /app/apps/api-python/pyproject.toml ./apps/api-python/pyproject.toml
COPY --from=builder /app/apps/api-python/uv.lock ./apps/api-python/uv.lock
COPY scripts/install-python-runtime.sh ./scripts/install-python-runtime.sh
COPY scripts/container-entry.py /opt/shuku-launcher/container-entry.py
COPY scripts/build-runtime-environment.py /opt/shuku-launcher/build-runtime-environment.py
COPY --from=mobi-core-builder /build/mobi-core/libermao_mobi_core.so /usr/local/lib/libermao_mobi_core.so
COPY --from=mobi-core-builder /build/chapters/libermao_chapters.so /usr/local/lib/libermao_chapters.so
COPY --from=mobi-core-builder /src/chapters /usr/share/shuku/source/chapters
COPY --from=mobi-core-builder /src/mobi-core/LICENSE /usr/share/licenses/shuku-mobi-core/LICENSE
COPY --from=mobi-core-builder /src/mobi-core/UPSTREAM.md /usr/share/licenses/shuku-mobi-core/UPSTREAM.md
COPY --from=mobi-core-builder /src/mobi-core /usr/share/shuku/source/mobi-core
RUN UV_NO_CACHE=1 sh ./scripts/install-python-runtime.sh /opt/shuku-image/apps/api-python /opt/shuku-python \
  && /opt/shuku-python/bin/python -m compileall -q ./apps/api-python/app \
  && rm -rf ./apps/api-python/build ./apps/api-python/*.egg-info \
  && chmod +x ./scripts/start-unified-app.sh \
  && mkdir -p /opt/shuku-image/apps/web/.next/cache /app/storage /books

RUN python /opt/shuku-launcher/build-runtime-environment.py \
  --output /opt/shuku-launcher/environment.json --program-root /opt/shuku-image \
  --native /usr/local/lib/libermao_mobi_core.so --native /usr/local/lib/libermao_chapters.so

EXPOSE 3000
CMD ["python", "/opt/shuku-launcher/container-entry.py"]
