#!/bin/bash
set -eu

. "$(dirname "$0")/docker-runtime.sh"

case "${1:-}" in
  start|stop)
    # Docker 项目的生命周期由 fnOS 根据 config/resource 统一管理。
    exit 0
    ;;
  status)
    if ! states="$(web_container_states)"; then
      case "${TRIM_SYS_LANGUAGE:-zh-CN}" in
        en*) printf '%s\n' 'Cannot query application container status. Check Docker and try again.' ;;
        *) printf '%s\n' '无法查询应用容器状态，请检查 Docker 后重试。' ;;
      esac > "${TRIM_TEMP_LOGFILE:-/dev/stderr}"
      exit 1
    fi
    if printf '%s\n' "$states" | grep -qx running; then
      exit 0
    fi
    exit 3
    ;;
  *)
    echo "不支持的应用操作：${1:-空}" > "${TRIM_TEMP_LOGFILE:-/dev/stderr}"
    exit 1
    ;;
esac
