@@ -0,0 +1,9 @@
+import type { Publication } from "@readium/shared";
+
+/** Preserve the active resource and at most one original resource on either side. */
+export function readingWindow(publication: Publication, href: string): Set<string> {
+    const order = publication.readingOrder.items;
+    const current = order.findIndex(link => link.href === href);
+    if (current < 0) throw new Error("READIUM_READING_ORDER_INVALID");
+    return new Set(order.slice(Math.max(0, current - 1), current + 2).map(link => link.href));
+}
