{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reader error codes accepted for each HTTP status",
  "type": "object",
  "additionalProperties": false,
  "required": ["publication", "comic"],
  "properties": {
    "publication": { "$ref": "#/$defs/group" },
    "comic": { "$ref": "#/$defs/group" }
  },
  "$defs": {
    "group": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "integer", "minimum": 400, "maximum": 599 }
      }
    }
  }
}
