{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shuku.app/contracts/txt-decoding-v2.schema.json",
  "title": "Shuku TXT Decoding v2 Conformance Fixtures",
  "description": "TXT decodes with BOM-aware replacement, otherwise strict UTF-8 followed by replacement GB18030. Decoded NUL and existing replacement characters are preserved; no error-ratio admission rules.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "ermao.txt-decoding"
    },
    "version": {
      "const": 2
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "expectedText": {
      "description": "Decoded text, including U+FFFD replacement for malformed input.",
      "type": "string",
      "minLength": 0,
      "maxLength": 4096
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceHex",
        "expectedText"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
        },
        "sourceHex": {
          "type": "string",
          "minLength": 0,
          "maxLength": 8192,
          "pattern": "^(?:[0-9a-f]{2})*$"
        },
        "expectedText": {
          "description": "Exact decoded text.",
          "$ref": "#/$defs/expectedText"
        },
        "decoderOverrides": {
          "description": "Verified native codec mapping differences; Web GB18030 follows WHATWG and maps byte 0x80 to the euro sign.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "web-textdecoder": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "expectedText"
              ],
              "properties": {
                "expectedText": {
                  "$ref": "#/$defs/expectedText"
                }
              }
            }
          }
        }
      }
    }
  }
}
