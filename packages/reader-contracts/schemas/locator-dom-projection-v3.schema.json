{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shuku.app/contracts/locator-dom-projection-v3.schema.json",
  "title": "Shuku Locator DOM Projection v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "normalization", "policyId", "policyVersion", "policyDigest", "readingOrder"],
  "properties": {
    "schemaVersion": {"const": 3},
    "normalization": {"type": "string", "pattern": "^shuku-[a-z0-9+.-]+-v3$", "maxLength": 256},
    "policyId": {"const": "shuku.reader-safety"},
    "policyVersion": {"type": "integer", "minimum": 1},
    "policyDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "readingOrder": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["href", "mediaType", "elements"],
        "properties": {
          "href": {"type": "string", "minLength": 1, "maxLength": 8192},
          "mediaType": {"enum": ["application/xhtml+xml", "text/html"]},
          "elements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "localName"],
              "properties": {
                "path": {"type": "string", "pattern": "^/body\\[1\\](?:/[a-zA-Z][a-zA-Z0-9-]*\\[[1-9][0-9]*\\])*$"},
                "localName": {"type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9-]*$"},
                "id": {"type": "string"},
                "text": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
